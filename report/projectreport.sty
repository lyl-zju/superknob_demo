\newcommand{\projecttitle}[1]{\def\theprojecttitle{#1}}
\newcommand{\projectcourse}[1]{\def\theprojectcourse{#1}}
\newcommand{\projectmembers}[2]{
  \def\theprojectmemberslineone{#1}
  \def\theprojectmemberslinetwo{#2}
}
\newcommand{\projectschool}[1]{\def\theprojectschool{#1}}
\newcommand{\projectteacher}[1]{\def\theprojectteacher{#1}}
