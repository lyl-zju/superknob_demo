\newcommand{\makeprojectcover}{
  \begin{titlepage}
    \vspace*{-2cm}
    \begin{figure}[h]
      \centering
      \includegraphics[width=0.65\linewidth]{figures/char.png}
    \end{figure}
    \begin{figure}[h]
      \centering
      \includegraphics[width=0.45\linewidth]{figures/logo.png}
    \end{figure}
    \vspace{0.5cm}
    \begin{center}
      {\Huge\bfseries 项目设计报告\\[0.4cm]}
      {\Large\bfseries\resizebox{0.96\linewidth}{!}{\theprojecttitle}}
    \end{center}
    \vspace{1.0cm}
    \begin{center}
      \Large
      \begin{tabular}{@{}r@{\ }c@{}}
        课程名称 & \underline{\makebox[300pt]{\theprojectcourse}}\\[0.35cm]
        小组成员 & \begin{tabular}[t]{@{}c@{}}
          \underline{\makebox[300pt]{\theprojectmemberslineone}}\\[0.18cm]
          \underline{\makebox[300pt]{\theprojectmemberslinetwo}}
        \end{tabular}\\[0.35cm]
        学\qquad 院 & \underline{\makebox[300pt]{\theprojectschool}}\\[0.35cm]
        指导教师 & \underline{\makebox[300pt]{\theprojectteacher}}\\[0.35cm]
        完成日期 & \underline{\makebox[300pt]{\theprojectdate}}
      \end{tabular}
    \end{center}
  \end{titlepage}
}

